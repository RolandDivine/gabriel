<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>GabrielApp</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Unpackaged + self-contained: produces a plain .exe you can run
         straight out of the output folder, with the Windows App SDK
         runtime carried alongside it. Without this the app would refuse to
         start unless the machine already had the WindowsAppRuntime
         installed separately, which is a poor first-run experience for
         something meant to be handed to someone. -->
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.*" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.*" />
  </ItemGroup>

  <!-- The Rust core, built by cargo into the workspace target dir. The
       app P/Invokes this; without it next to the .exe, startup fails with
       a DllNotFoundException. -->
  <ItemGroup>
    <None Include="..\..\target\debug\gabriel_ffi.dll" Condition="Exists('..\..\target\debug\gabriel_ffi.dll')">
      <Link>gabriel_ffi.dll</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
